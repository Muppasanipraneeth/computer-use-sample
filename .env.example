# Copy to .env. Both backends read this file. Shell variables take precedence.
# These are API keys from each provider's account, not a browser login.
# Cursor cannot be used: it has no API that runs this loop.

# OpenAI Responses API. Required for the OpenAI provider.
OPENAI_API_KEY=""

# Claude Messages API. Required when the model starts with anthropic:
ANTHROPIC_API_KEY=""

# Any server that accepts OpenAI chat-completions tools and images.
# Required when the model starts with compatible:
# CUA_COMPATIBLE_BASE_URL="https://openrouter.ai/api/v1"
# CUA_COMPATIBLE_API_KEY=""

# Optional. Unprefixed means OpenAI. Prefixes select another provider:
# CUA_DEFAULT_MODEL="gpt-6-astra"
# CUA_DEFAULT_MODEL="anthropic:claude-sonnet-4-5"
# CUA_DEFAULT_MODEL="compatible:your-model-id"
# HOST="127.0.0.1"
# PORT="4001"
# CUA_ALLOWED_ORIGINS="http://127.0.0.1:3000"


