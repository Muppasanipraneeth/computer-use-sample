# Copy to .env. Both backends read this file. Shell variables take precedence.
# These are API keys from each provider's account, not a browser login.
# Cursor cannot be used: it has no API that runs this loop.

# OpenAI Responses API. Required for the OpenAI provider.
OPENAI_API_KEY=""

# Claude Messages API. Required when the model starts with anthropic:
ANTHROPIC_API_KEY=""

# Any server that accepts OpenAI chat-completions tools and images.
# Required when the model starts with compatible:
# JARVIS_COMPATIBLE_BASE_URL="https://openrouter.ai/api/v1"
# JARVIS_COMPATIBLE_API_KEY=""

# Cloudflare Browser Run (optional): moves Jarvis's background browser (the "Any task" workspace) from a
# headless Chromium on this computer to Cloudflare's cloud.
# Create an API token with the "Browser Rendering - Edit" permission. The Python runner keeps
# the token; model code only gets a local gateway URL.
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""

# Composio (optional): lets Jarvis use Gmail, Google Calendar, Slack, X, GitHub, Notion, Google Drive and
# LinkedIn through their APIs. Connect apps in Settings → Connections. Project API key from
# https://platform.composio.dev. The runner keeps the key; model code only gets a local gateway URL.
# X has no Composio-managed sign-in: add an X auth config with your own X developer credentials first.
# COMPOSIO_API_KEY=""

# Optional. Unprefixed means OpenAI. Prefixes select another provider:
# JARVIS_DEFAULT_MODEL="gpt-6-astra"
# JARVIS_DEFAULT_MODEL="anthropic:claude-sonnet-4-5"
# JARVIS_DEFAULT_MODEL="compatible:your-model-id"
# HOST="127.0.0.1"
# PORT="4001"
# JARVIS_ALLOWED_ORIGINS="http://127.0.0.1:3000"
# Python runner: how many tasks may run at once (default 3).
# JARVIS_MAX_CONCURRENT_RUNS="3"


